<Project Sdk="Microsoft.NET.Sdk">
  <!-- Host-side tests for XivLantern.Core. Nothing here loads Dalamud, native code or the network. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <RootNamespace>XivLantern.Core.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\XivLantern.Core\XivLantern.Core.csproj" />
    <Compile Include="..\..\src\Shared\IpcContract.cs" Link="Shared\IpcContract.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepoRoot" Value="$(MSBuildThisFileDirectory)../.." />
  </ItemGroup>
</Project>
