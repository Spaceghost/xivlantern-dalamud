<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <AssemblyName>XivLinkpearl</AssemblyName>
    <RootNamespace>XivLinkpearl.Plugin</RootNamespace>
    <Version>0.1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Windows build of the native library (tools/build-native.sh puts it here). -->
    <LinkpearlNativeDir Condition="'$(LinkpearlNativeDir)' == ''">$(MSBuildThisFileDirectory)../../../ffxiv-linkpearl-build/native/</LinkpearlNativeDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XivLinkpearl.Core\XivLinkpearl.Core.csproj" />
    <ProjectReference Include="..\..\bindings\csharp\Linkpearl\Linkpearl.csproj" />
    <Compile Include="..\Shared\IpcContract.cs" Link="Shared\IpcContract.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- linkpearl.dll travels beside XivLinkpearl.dll and is loaded from the plugin's own folder. -->
    <None Include="$(LinkpearlNativeDir)linkpearl.dll" Condition="Exists('$(LinkpearlNativeDir)linkpearl.dll')"
          Link="linkpearl.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="WarnWithoutNative" BeforeTargets="Build" Condition="!Exists('$(LinkpearlNativeDir)linkpearl.dll')">
    <Warning Text="linkpearl.dll not found in $(LinkpearlNativeDir): run tools/build-native.sh. The plugin builds, but cannot connect without it." />
  </Target>
</Project>
