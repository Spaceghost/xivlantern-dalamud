<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure library: commands, the chat model, notification rules, JSON from the native layer, the IPC payloads.
       BCL only: no Dalamud, no native code, so all of it is tested on the host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>XivLantern.Core</RootNamespace>
    <AssemblyName>XivLantern.Core</AssemblyName>
    <Version>0.1.0.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XivLantern.Core.Tests" />
  </ItemGroup>
</Project>
